# StudyMind AI - Environment Configuration

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional OpenAI or OpenAI-compatible provider (OpenAI, Groq, OpenRouter, Together, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Local Ollama Server (e.g. http://localhost:11434)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Optional Web Search (Tavily / Serper, or built-in DuckDuckGo/Wikipedia instant lookup)
TAVILY_API_KEY=
SERPER_API_KEY=
ENABLE_WEB_SEARCH=true

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/studymind.db

# JWT Authentication & Security
JWT_SECRET=studymind_rag_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# RAG Ingestion parameters
CHUNK_SIZE=750
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.1
EMBEDDING_MODEL=hybrid-semantic
