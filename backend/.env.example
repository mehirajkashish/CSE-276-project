# StudyMind AI - Environment Configuration

# Google Gemini API Key (Optional: get from https://aistudio.google.com/app/apikey)
# If left empty, StudyMind AI runs with its built-in Local RAG synthesis engine.
GEMINI_API_KEY=

# Model selection: gemini-1.5-flash, gemini-2.0-flash, or gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/studymind.db

# JWT Authentication & Security
JWT_SECRET=studymind_rag_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# RAG Ingestion parameters
CHUNK_SIZE=750
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
