# StudyMind AI - Frontend Environment Configuration

# Production Backend API URL
# Leave blank or set to '/api' for local proxy development
# In production on GitHub Pages, set to your hosted backend URL:
# VITE_API_URL=https://your-backend-api.onrender.com/api
VITE_API_URL=/api

# GitHub Pages Base Path (e.g. /studymind-ai/ if repository name is studymind-ai)
# Defaults to './' for root or relative path
VITE_BASE_PATH=./
